generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id                  String                  @id @default(cuid())
  name                String?
  email               String?                 @unique
  passwordHash        String?
  role                Role                    @default(EMPLOYEE)
  managerId           String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  emailVerified       DateTime?
  image               String?
  departmentId        String?
  insights            AIInsight[]
  accounts            Account[]
  auditLogs           AuditLog[]
  assignedEscalations Escalation[]            @relation("AssignedEscalations")
  reportedEscalations Escalation[]            @relation("ReportedEscalations")
  ownedGoals          Goal[]                  @relation("OwnedGoals")
  goalApprovals       GoalApproval[]
  checkIns            GoalUpdate[]            @relation("UpdateCheckIns")
  goalUpdates         GoalUpdate[]
  notifications       Notification[]
  reports             Report[]
  sessions            Session[]
  sharedGoals         SharedGoalParticipant[]
  department          Department?             @relation(fields: [departmentId], references: [id])
  manager             User?                   @relation("ManagerEmployees", fields: [managerId], references: [id])
  employees           User[]                  @relation("ManagerEmployees")
  settings            UserSettings?

  @@index([managerId])
  @@index([departmentId])
}

model UserSettings {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  notificationPreferences Json     @default("{}")
  integrationPreferences  Json     @default("{}")
  securityPreferences     Json     @default("{}")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id                String                  @id @default(cuid())
  title             String
  description       String?
  target            Float                   @default(0)
  achievement       Float                   @default(0)
  weightage         Int                     @default(10)
  status            GoalStatus              @default(DRAFT)
  locked            Boolean                 @default(false)
  ownerId           String
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  thrustArea        String                  @default("General")
  unitOfMeasurement UnitOfMeasurement       @default(NUMERIC)
  startValue        Float?
  targetValue       Float                   @default(0)
  currentValue      Float                   @default(0)
  priority          Priority                @default(MEDIUM)
  quarter           Quarter                 @default(Q1)
  cycleId           String                  @default("2026")
  startDate         DateTime?
  dueDate           DateTime?
  endDate           DateTime?
  isShared          Boolean                 @default(false)
  isLocked          Boolean                 @default(false)
  primaryGoalId     String?
  calculationType   CalculationType         @default(MIN)
  progress          Float                   @default(0)
  insights          AIInsight[]
  escalations       Escalation[]
  owner             User                    @relation("OwnedGoals", fields: [ownerId], references: [id], onDelete: Cascade)
  primaryGoal       Goal?                   @relation("LinkedGoals", fields: [primaryGoalId], references: [id])
  linkedGoals       Goal[]                  @relation("LinkedGoals")
  approvals         GoalApproval[]
  updates           GoalUpdate[]
  participants      SharedGoalParticipant[] @relation("SharedGoalParticipants")
  linkedParticipant SharedGoalParticipant?  @relation("SharedGoalLinkedCopy")

  @@index([ownerId])
  @@index([status])
  @@index([cycleId])
  @@index([primaryGoalId])
}

model GoalUpdate {
  id                 String            @id @default(cuid())
  goalId             String
  userId             String
  cadence            GoalUpdateCadence @default(WEEKLY)
  previousValue      Float
  newValue           Float
  progressPercentage Float             @default(0)
  accomplishments    Json              @default("[]")
  blockers           Json              @default("[]")
  nextSteps          Json              @default("[]")
  comment            String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  actualAchievement  Float             @default(0)
  checkedInAt        DateTime?
  checkedInById      String?
  computedProgress   Float             @default(0)
  managerComment     String?
  status             ProgressStatus    @default(ON_TRACK)
  checkedInBy        User?             @relation("UpdateCheckIns", fields: [checkedInById], references: [id])
  goal               Goal              @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([userId])
  @@index([cadence])
}

model SharedGoalParticipant {
  id           String   @id @default(cuid())
  goalId       String
  userId       String
  linkedGoalId String?  @unique
  canEdit      Boolean  @default(false)
  createdAt    DateTime @default(now())
  goal         Goal     @relation("SharedGoalParticipants", fields: [goalId], references: [id], onDelete: Cascade)
  linkedGoal   Goal?    @relation("SharedGoalLinkedCopy", fields: [linkedGoalId], references: [id])
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([goalId, userId])
  @@index([userId])
}

model GoalApproval {
  id        String     @id @default(cuid())
  goalId    String
  managerId String
  status    GoalStatus
  comment   String?
  createdAt DateTime   @default(now())
  goal      Goal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  manager   User       @relation(fields: [managerId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([managerId])
}

model AIInsight {
  id        String      @id @default(cuid())
  type      InsightType
  content   String
  goalId    String?
  createdAt DateTime    @default(now())
  userId    String?
  goal      Goal?       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  userId    String
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

model Escalation {
  id           String           @id @default(cuid())
  title        String
  description  String
  status       EscalationStatus @default(OPEN)
  reporterId   String
  assignedToId String?
  goalId       String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  assignedTo   User?            @relation("AssignedEscalations", fields: [assignedToId], references: [id])
  goal         Goal?            @relation(fields: [goalId], references: [id], onDelete: Cascade)
  reporter     User             @relation("ReportedEscalations", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([assignedToId])
  @@index([goalId])
}

model Report {
  id        String       @id @default(cuid())
  format    ReportFormat
  createdAt DateTime     @default(now())
  fileData  Bytes?
  name      String
  status    ReportStatus @default(PENDING)
  type      ReportType
  updatedAt DateTime     @updatedAt
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  resource   String
  resourceId String?
  details    String?
  userId     String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resource, resourceId])
}

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum GoalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REWORK
  RETURNED_FOR_REWORK
  LOCKED
  COMPLETED
}

enum UnitOfMeasurement {
  NUMERIC
  PERCENTAGE
  TIMELINE
  ZERO_BASED
}

enum CalculationType {
  MIN
  MAX
  TIMELINE
  ZERO
}

enum ProgressStatus {
  NOT_STARTED
  ON_TRACK
  AT_RISK
  COMPLETED
}

enum GoalUpdateCadence {
  WEEKLY
  QUARTERLY
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  GOAL_ASSIGNED
  GOAL_UPDATED
  APPROVAL_REQUIRED
  ESCALATION
  SYSTEM
}

enum EscalationStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum InsightType {
  RISK
  OPPORTUNITY
  ANOMALY
  SUMMARY
}

enum Quarter {
  GOAL_SETTING
  Q1
  Q2
  Q3
  ANNUAL_REVIEW
}

enum ReportType {
  GOAL_SUMMARY
  ANALYTICS
  AUDIT
  ESCALATION
}

enum ReportFormat {
  EXCEL
  PDF
}

enum ReportStatus {
  PENDING
  COMPLETED
  FAILED
}
